{
  "name": "sticker-maker-desktop",
  "version": "0.3.0",
  "description": "表情包一键制作 - Mac/Windows 桌面应用",
  "author": "捞鱼工作室 <lyzbcy>",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "test": "vitest run",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:mac": "vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "pinia": "^2.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "jsdom": "^24.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.lyzbcy.sticker-maker",
    "productName": "表情包一键制作",
    "directories": {
      "output": "release"
    },
    "afterPack": "afterPack.js",
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "afterPack.js"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "../sticker_engine/dist/sticker-engine-cli",
          "to": "sticker-engine-cli"
        },
        {
          "from": "install.command",
          "to": "install.command"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "../sticker_engine/dist/sticker-engine-cli",
          "to": "sticker-engine-cli"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "sticker-maker-win-v${version}-setup.${ext}",
      "shortcutName": "表情包一键制作"
    }
  }
}
